  <dialog id="admin-dialog"><div class="dialog-body"><button type="button" class="close-dialog" id="close-dialog" aria-label="Fechar"><svg class="ic"><use href="#i-x"/></svg></button><svg class="ic big-dialog-icon"><use href="#i-shield"/></svg><h2>Área do ADM</h2><p>O painel administrativo não foi configurado nesta versão do site. As inscrições são enviadas diretamente ao WhatsApp da organização.</p><button type="button" class="btn btn-neon" id="okay-dialog">ENTENDI</button></div></dialog>
<script>
(() => {
  'use strict';
  // Altere somente este telefone se o contato da organização mudar.
  const WHATSAPP_ORGANIZACAO = '5581994706810';
  const viewNames = ['inicio', 'inscricoes', 'regulamento', 'categorias', 'tabela', 'premiacao'];
  const viewSet = new Set(viewNames);
  const nav = document.getElementById('nav');
  const toggle = document.getElementById('toggle-menu');
  const form = document.getElementById('signup');
  const ageInput = document.getElementById('idade');
  const categoryInput = document.getElementById('categoria');
  const ageFeedback = document.getElementById('age-feedback');
  const feedback = document.getElementById('form-feedback');
  const phoneInput = document.getElementById('telefone');

  function viewFromHash() {
    const name = decodeURIComponent(location.hash.slice(1));
    return viewSet.has(name) ? name : 'inicio';
  }

  function showView(name, changeHash = true) {
    if (!viewSet.has(name)) name = 'inicio';
    document.querySelectorAll('[data-view]').forEach(section => {
      section.hidden = section.dataset.view !== name;
    });
    document.querySelectorAll('[data-nav]').forEach(link => {
      const isActive = link.dataset.nav === name;
      link.classList.toggle('active', isActive);
      if (isActive) link.setAttribute('aria-current', 'page');
      else link.removeAttribute('aria-current');
    });
    nav.classList.remove('open');
    toggle.setAttribute('aria-expanded', 'false');
    toggle.setAttribute('aria-label', 'Abrir menu');
    if (changeHash) {
      if (location.hash !== `#${name}`) history.pushState(null, '', `#${name}`);
      document.querySelector('.main-area').scrollIntoView({behavior:'smooth', block:'start'});
    }
  }
  document.querySelectorAll('[data-open]').forEach(button => button.addEventListener('click', () => showView(button.dataset.open)));
  document.querySelectorAll('[data-nav]').forEach(link => link.addEventListener('click', evt => {
    if (!viewSet.has(link.dataset.nav)) return;
    evt.preventDefault();
    showView(link.dataset.nav);
  }));
  toggle.addEventListener('click', () => {
    const opening = !nav.classList.contains('open');
    nav.classList.toggle('open', opening);
    toggle.setAttribute('aria-expanded', String(opening));
    toggle.setAttribute('aria-label', opening ? 'Fechar menu' : 'Abrir menu');
  });
  window.addEventListener('popstate', () => showView(viewFromHash(), false));
  window.addEventListener('hashchange', () => showView(viewFromHash(), false));
  showView(viewFromHash(), false);

  const adminDialog = document.getElementById('admin-dialog');
  document.getElementById('adm-btn').addEventListener('click', () => adminDialog.showModal());
  document.getElementById('close-dialog').addEventListener('click', () => adminDialog.close());
  document.getElementById('okay-dialog').addEventListener('click', () => adminDialog.close());
  adminDialog.addEventListener('click', event => { if (event.target === adminDialog) adminDialog.close(); });

  function categoryFromAge(raw) {
    const value = String(raw).trim();
    if (!/^\d{1,3}$/.test(value)) return '';
    const age = Number(value);
    if (age >= 14 && age <= 17) return 'Juvenil';
    if (age >= 18 && age <= 120) return 'Adulto';
    return '';
  }
  function updateCategory() {
    const raw = ageInput.value.trim();
    categoryInput.value = categoryFromAge(raw);
    ageFeedback.classList.remove('error','success');
    if (!raw) {
      ageFeedback.textContent = 'Juvenil: de 14 a 17 anos • Adulto: a partir de 18 anos.';
    } else if (!categoryInput.value) {
      ageFeedback.textContent = 'Idade inválida. Para participar, o jogador deve ter 14 anos ou mais.';
      ageFeedback.classList.add('error');
    } else {
      ageFeedback.textContent = `Categoria definida automaticamente: ${categoryInput.value}.`;
      ageFeedback.classList.add('success');
    }
  }
  ageInput.addEventListener('input', updateCategory);

  function formatPhone(raw) {
    const digits = raw.replace(/\D/g, '').slice(0, 11);
    if (digits.length <= 2) return digits ? `(${digits}` : '';
    if (digits.length <= 6) return `(${digits.slice(0,2)}) ${digits.slice(2)}`;
    if (digits.length <= 10) return `(${digits.slice(0,2)}) ${digits.slice(2,6)}-${digits.slice(6)}`;
    return `(${digits.slice(0,2)}) ${digits.slice(2,7)}-${digits.slice(7)}`;
  }
  phoneInput.addEventListener('input', () => {
    // A máscara não interfere na quantidade de dígitos usada para validar.
    phoneInput.value = formatPhone(phoneInput.value);
  });
  function showError(message, element) {
    feedback.hidden = false;
    feedback.classList.remove('success');
    feedback.textContent = message;
    if (element) { element.focus(); element.scrollIntoView({behavior:'smooth',block:'center'}); }
  }
  const trim = name => String(form.elements.namedItem(name).value).trim().replace(/\s+/g,' ');
  form.addEventListener('submit', event => {
    event.preventDefault();
    feedback.hidden = true;
    const fields = [
      ['responsavel', 'nome do responsável'],
      ['time', 'nome do time'],
      ['jogador', 'nome do jogador'],
      ['goleiro', 'nome do goleiro']
    ];
    for (const [field, label] of fields) {
      if (trim(field).length < 3) { showError(`Preencha corretamente o ${label} (pelo menos 3 caracteres).`,form.elements.namedItem(field)); return; }
    }
    const digits = phoneInput.value.replace(/\D/g, '');
    if (!/^\d{10,11}$/.test(digits)) { showError('Informe um telefone válido com DDD (10 ou 11 números).',phoneInput); return; }
    const age = Number(ageInput.value);
    if (!Number.isInteger(age) || age < 14 || age > 120) { showError('A idade precisa ser um número inteiro de 14 anos ou mais.',ageInput); return; }
    updateCategory();
    const category = categoryInput.value;
    if (!category) { showError('Não foi possível determinar a categoria. Confira a idade.',ageInput); return; }

    const lines = [
      '*INSCRIÇÃO — TORNEIO DE PÊNALTIS MISSÃO CALEBE*',
      '',
      `*Responsável:* ${trim('responsavel')}`,
      `*Telefone do responsável:* ${formatPhone(digits)}`,
      `*Nome do time:* ${trim('time')}`,
      `*Nome do jogador:* ${trim('jogador')}`,
      `*Nome do goleiro:* ${trim('goleiro')}`,
      `*Idade do jogador:* ${age} anos`,
      `*Categoria:* ${category}`
    ];
    const url = `https://wa.me/${WHATSAPP_ORGANIZACAO}?text=${encodeURIComponent(lines.join('\n'))}`;
    feedback.hidden = false;
    feedback.classList.add('success');
    feedback.textContent = 'O WhatsApp será aberto com sua mensagem. Toque em Enviar para concluir a inscrição.';
    // Abrir a partir do clique do usuário. Se o navegador bloquear, o link fica disponível.
    const opened = window.open(url, '_blank');
    if (opened) {
      try { opened.opener = null; } catch (_) {}
    } else {
      feedback.classList.remove('success');
      feedback.textContent = 'O navegador bloqueou a nova aba. Use o link de WhatsApp mostrado abaixo.';
    }
    const oldLink = document.getElementById('manual-whatsapp-link');
    if (oldLink) oldLink.remove();
    const manualLink = document.createElement('a');
    manualLink.id = 'manual-whatsapp-link';
    manualLink.href = url;
    manualLink.target = '_blank';
    manualLink.rel = 'noopener noreferrer';
    manualLink.textContent = 'Abrir inscrição no WhatsApp';
    manualLink.style.cssText = 'display:inline-block;margin-top:9px;color:#b1ff3e;text-decoration:underline;font-weight:800';
    feedback.appendChild(document.createElement('br'));
    feedback.appendChild(manualLink);
  });
})();

</script>
